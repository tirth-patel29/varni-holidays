# ==============================================================================
# VARNI HOLIDAYS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Safe template for development, staging, and production environments.
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or expose production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon via Prisma ORM)
# ------------------------------------------------------------------------------
# Pooled connection string (required for serverless runtime & PgBouncer)
DATABASE_URL="postgresql://user:password@ep-cool-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct unpooled connection string (used by Prisma CLI for migrations & schema push)
DIRECT_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & HOSTING
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. RESEND TRANSACTIONAL EMAIL INTEGRATION
# ------------------------------------------------------------------------------
# API key from Resend dashboard (https://resend.com/api-keys)
RESEND_API_KEY="re_sample_1234567890abcdefghijklmnopqrstuvwxyz"

# Verified sender address on Resend (domain: varnitours.com)
RESEND_FROM_EMAIL="Varni Holidays <noreply@varnitours.com>"

# ------------------------------------------------------------------------------
# 4. META WHATSAPP BUSINESS CLOUD API INTEGRATION
# ------------------------------------------------------------------------------
# Permanent System User Access Token from Meta Business Manager
WHATSAPP_API_TOKEN="EAAXsampleMetaAccessTokenPlaceholder"

# 15-digit Phone Number ID assigned by Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID="109876543210987"

# 15-digit WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID="109876543210988"

# Self-defined secret token for Meta Webhook verification handshake
WHATSAPP_VERIFY_TOKEN="varni_webhook_verification_token_2026"

# Meta App Secret (from Meta Developer Portal App Settings -> Basic) for HMAC SHA-256 verification
WHATSAPP_APP_SECRET="0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 5. GOOGLE SHEETS LIVE BUSINESS REPORTING (Google Sheets API v4)
# ------------------------------------------------------------------------------
# Target Google Spreadsheet ID (from spreadsheet URL)
GOOGLE_SHEETS_SPREADSHEET_ID="1fVwhzsYrZ5c8xmLSobxTXP8M1JNeqL5-ZSbnq3gZY3A"

# Google Cloud IAM Service Account Email
GOOGLE_SERVICE_ACCOUNT_EMAIL="varni-sheets-sync@varni-holidays-crm.iam.gserviceaccount.com"

# Google Service Account RSA Private Key (Escape linebreaks with \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional: Google Apps Script Webhook URL (alternative to Service Account)
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbx_sample_webhook/exec"

# ------------------------------------------------------------------------------
# 6. OFFICIAL PUBLIC COMPANY CONTACT DETAILS (Client-safe)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_OFFICE_PHONE="+91 63570 50505"
NEXT_PUBLIC_WHATSAPP_NUMBER="916357050505"
NEXT_PUBLIC_OFFICE_EMAIL="varniinternational7@gmail.com"
NEXT_PUBLIC_OFFICE_ADDRESS="317, 3rd Floor, Narayan Empire, Anand - Vidyanagar Road, Anand, Gujarat 388120"

